+def normalize_dav_rows(rows, source_columns, output_folder):
+    """Run the shared detailed DAV normalizer and attach its results by source ID.
+
+    Silver remains one row per DAV source record. Component-level results are
+    retained as JSON on that row so the mapping job consumes the same parsed
+    ingredients and strengths without multiplying or losing source records.
+    """
+    from silver_v3.safe_tools.dav_normalizer_v3 import normalize as normalize_dav
+
+    root = Path(output_folder)
+    with tempfile.TemporaryDirectory(prefix="dav-normalize-", dir=root) as temp:
+        work = Path(temp)
+        source_csv = work / "dav_source.csv"
+        normalized_dir = work / "normalized"
+        with source_csv.open("w", encoding="utf-8-sig", newline="") as stream:
+            writer = csv.DictWriter(stream, fieldnames=source_columns, lineterminator="\n")
+            writer.writeheader()
+            writer.writerows(rows)
+
+        normalize_dav(source_csv, normalized_dir)
+
+        def read_rows(path):
+            with path.open("r", encoding="utf-8-sig", newline="") as stream:
+                return list(csv.DictReader(stream))
+
+        product_rows = read_rows(normalized_dir / "dav_product_normalized_v2.csv")
+        component_rows = read_rows(normalized_dir / "dav_component_normalized_v2.csv")
+        products = {row["dav_row_id"]: row for row in product_rows}
+        components = {}
+        for row in component_rows:
+            components.setdefault(row["dav_row_id"], []).append(row)
+        if len(products) != len(rows):
+            raise ValueError(
+                f"DAV normalizer product count mismatch: {len(products)} != {len(rows)}"
+            )
+
+        for row in rows:
+            row_id = row["dav_row_id"]
+            product = products.get(row_id)
+            if product is None:
+                raise ValueError(f"DAV normalizer omitted source row {row_id}")
+            row.update({key: value for key, value in product.items() if key != "dav_row_id"})
+            row_components = components.get(row_id, [])
+            row["silver_dav_components_json"] = json.dumps(
+                row_components, ensure_ascii=False, separators=(",", ":")
+            )
+            row["silver_dav_component_count"] = str(len(row_components))
+            row["silver_dav_component_readiness"] = (
+                "REVIEW_BEFORE_RXNORM_MAPPING"
+                if any(c.get("mapping_readiness_v2") != "READY_FOR_RXNORM_CANDIDATE"
+                       for c in row_components)
+                else "READY_FOR_RXNORM_CANDIDATE"
+            )
+            row["silver_dav_normalization_review_reasons"] = "|".join(sorted({
+                reason
+                for component in row_components
+                for reason in component.get("review_reason", "").split("|")
+                if reason
+            }))
+    return rows
 
